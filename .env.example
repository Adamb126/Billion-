# ----------------------------------------------------------------------------
# Recovery Studio OS — environment configuration
# Copy this file to ".env" and fill in real values.
# ----------------------------------------------------------------------------

# --- Database -----------------------------------------------------------------
# Local dev default is a SQLite file. For production, point this at a hosted
# Postgres (e.g. Neon, Supabase, Railway) and change the provider in
# prisma/schema.prisma from "sqlite" to "postgresql".
DATABASE_URL="file:./dev.db"

# --- First studio (used to SEED the initial studio into the database) ---------
# The app is multi-tenant: studios live in the database, each with its own
# booking URL at /<slug>. These values seed the FIRST studio on `npm run setup`.
# Adding more studios later is a DB insert, not an env change.
STUDIO_SLUG="my-studio"
STUDIO_NAME="My Recovery Studio"
# Public base URL of the app (used for Stripe redirect + email links).
# In dev this is http://localhost:3000
APP_URL="http://localhost:3000"
# Currency for Stripe charges + price display (ISO code, lowercase for Stripe).
CURRENCY="eur"

# --- Owner login (seeded onto the first studio) -------------------------------
# The single back-office login for the studio owner.
OWNER_EMAIL="owner@example.com"
# Plain password for v1 simplicity. Change this to something strong.
OWNER_PASSWORD="changeme"
# Secret used to sign the owner's session cookie. Generate a random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="please-change-me-to-a-long-random-string"

# --- Stripe -------------------------------------------------------------------
# Leave BLANK to run in DEV / SIMULATED-PAYMENT mode: bookings are confirmed
# instantly without a real charge, so you can test the whole flow with no keys.
# Fill these in to take real card payments via Stripe Checkout.
STRIPE_SECRET_KEY=""
# From the Stripe CLI (`stripe listen`) or the Dashboard webhook settings.
STRIPE_WEBHOOK_SECRET=""

# --- Email (booking confirmations) --------------------------------------------
# Leave BLANK to log emails to the server console instead of sending them
# (handy for local dev). Fill in SMTP details to send real email.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
# The "from" address on confirmation emails.
EMAIL_FROM="My Recovery Studio <bookings@example.com>"
